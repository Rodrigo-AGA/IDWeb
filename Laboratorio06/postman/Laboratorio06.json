{
  "info": {
    "name": "Lab 06 - API de Cursos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "cursoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET",
      "item": [
        {
          "name": "Listar todos los cursos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"data es un arreglo\", () => pm.expect(j.data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por créditos (=4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos?creditos=4",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ],
              "query": [
                {
                  "key": "creditos",
                  "value": "4"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Todos tienen 4 créditos\", () => j.data.forEach(c => pm.expect(c.creditos).to.eql(4)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener curso por id (existente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve el curso 1\", () => pm.expect(pm.response.json().data.id).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener curso por id (inexistente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"status = fail\", () => pm.expect(pm.response.json().status).to.eql(\"fail\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "POST",
      "item": [
        {
          "name": "Crear curso (válido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sistemas Operativos\",\n  \"codigo\": \"SOP501\",\n  \"creditos\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"cursoId\", j.data.id);",
                  "pm.test(\"Se creó con id y créditos numéricos\", () => {",
                  "  pm.expect(j.data.id).to.be.a(\"number\");",
                  "  pm.expect(j.data.creditos).to.eql(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear curso (faltan campos)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sin código\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensaje de campos obligatorios\", () => pm.expect(pm.response.json().message).to.include(\"obligatorios\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear curso (código duplicado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Duplicado\",\n  \"codigo\": \"SOP501\",\n  \"creditos\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "PUT",
      "item": [
        {
          "name": "Actualizar curso (existente)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Sistemas Operativos II\",\n  \"creditos\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Se actualizó el nombre\", () => pm.expect(pm.response.json().data.nombre).to.eql(\"Sistemas Operativos II\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar curso (inexistente)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "999"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No existe\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "DELETE",
      "item": [
        {
          "name": "Eliminar curso (existente)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mensaje de confirmación\", () => pm.expect(pm.response.json().message).to.include(\"eliminado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar eliminación (debe dar 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/{{cursoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "{{cursoId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar curso (inexistente)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cursos/999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cursos",
                "999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "Error no controlado (500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/error-test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "error-test"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 500\", () => pm.response.to.have.status(500));",
                  "pm.test(\"status = error\", () => pm.expect(pm.response.json().status).to.eql(\"error\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ruta inexistente (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/no-existe",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "no-existe"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}